{
	"name": "seo-checker",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/dompurify": "^3.0.5",
		"@types/marked": "^5.0.2",
		"@types/sql.js": "^1.4.11",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"typescript": "^6.0.2",
		"vite": "^8.0.7"
	},
	"dependencies": {
		"@codemirror/lang-sql": "^6.10.0",
		"codemirror": "^6.0.2",
		"dompurify": "^3.4.5",
		"jspdf": "^4.2.1",
		"marked": "^18.0.4",
		"sql.js": "^1.14.1"
	}
}
